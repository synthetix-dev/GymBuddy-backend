{
  "name": "@gymbuddy/backend",
  "version": "1.0.0",
  "private": true,
  "description": "GymBuddy Production Backend — Supabase PostgreSQL/PostGIS + Edge/RPC Modular Monolith",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "worker:outbox": "tsx src/workers/run-workers.ts",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "sdk:generate": "tsx scripts/generate-swift-sdk.ts",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "drill:rotate-keys": "tsx scripts/key-rotation-drill.ts",
    "load:test": "tsx scripts/load-test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "supabase": "^2.121.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
