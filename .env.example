DATABASE_DIRECT_URL=postgresql://localhost:5432/gymbuddy_dev
DATABASE_TEST_URL=postgresql://localhost:5432/gymbuddy_test

# --- Universal App Links ---
PUBLIC_APP_URL=https://gymbuddy.app
APPLE_APP_SITE_ASSOCIATION_TEAM_ID=TEAMID1234.com.gymbuddy.app

# --- APNs Push Notifications ---
APNS_KEY_ID=APNSKEY123
APNS_TEAM_ID=TEAMID1234
APNS_BUNDLE_ID=com.gymbuddy.app
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEV_PLACEHOLDER\n-----END PRIVATE KEY-----"
